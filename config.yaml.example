# AiCSO 配置文件
# 复制为 config.yaml 并填入实际值

llm:
  enabled: true          # false = 关闭所有LLM调用，纯聚合模式运行（内网无LLM时使用）
  default_provider: deepseek
  providers:
    deepseek:
      api_key: your-api-key-here
      base_url: https://api.deepseek.com
      model: deepseek-chat
      max_tokens: 4096
      temperature: 0.1
    openai:
      api_key: ${OPENAI_API_KEY}
      model: gpt-4o
      max_tokens: 4096
      temperature: 0.1
    ollama:
      base_url: http://localhost:11434
      model: qwen2.5:14b
      max_tokens: 4096

  budget:
    daily_limit: 1000000
    monthly_limit: 20000000
    alert_on_percent: 80

  context:
    max_context_tokens: 120000
    summary_threshold: 80000
    truncation_strategy: smart

database:
  url: sqlite+aiosqlite:///./aicso.db
  profile: sqlite               # 存储profile缝：postgres等见 docs/REFACTOR_DESIGN.md §12

# 告警保留策略（容量治理，0天=不清理）
retention:
  alert_days: 0
  cleanup_interval_minutes: 60
  scope: closed_cases           # orphan_only | closed_cases | all

vector_store:
  provider: chromadb
  path: ./data/chromadb
  embedding_model: BAAI/bge-small-zh-v1.5
  similarity_threshold: 0.7

server:
  host: 0.0.0.0
  port: 8000

logging:
  level: INFO
  format: json

# 象信AI System One 判定模型（分流引擎，见 docs/REFACTOR_DESIGN.md §5 §10）
# api_key 从项目根 .env 读取（XX-AI-KEY=sk-xx-...），.env 不入库
system_one:
  enabled: true                # false = 纯本地兜底分流（内网无外网形态）
  base_url: https://api.xiangxinai.cn/v1
  api_key: ${XX-AI-KEY}
  model: xiangxin-latest
  batch_window_ms: 100         # 微批聚合窗口
  batch_max_alerts: 50         # 单批条数上限
  token_budget: 32000          # 单请求token估算预算（超预算切子批，防422/连接中断整流降级，#42）
  timeout_ms: 2000
  confidence_threshold: 0.6    # 低于阈值 → 保守新建Case + 人工复核
  cache_ttl_seconds: 60
  fallback: local_rules
  candidate_top_k: 10
  review_queue_enabled: true

# 路由队列与背压
routing:
  queue_max_size: 10000
  high_water_mark: 0.8
  overload_mark: 0.95
  s2_concurrency: 3
  # 类型化实体白名单（issue #44）：进候选索引的弱实体类型，
  # ECS源默认提取 host/user/file_hash/dst_domain；可按审计/处置结论增删
  entity_types: [host, user, file_hash, dst_domain]
  # 弱实体自动合并：默认关——弱实体仅产生候选交模型裁决；
  # 开启后共享弱实体在pair窗内直接汇入（误并风险自担）
  weak_entity_auto_merge: false

# 数据源配置
datasources:
  # 示例：Kafka消费（内网SIEM常用）
  # schema映射（issue #35）：
  #   schema: auto（默认）= 首条消息自动探测，ECS格式(含@timestamp+source.ip)零映射接入
  #   schema: ecs         = 显式Elastic ECS 8.x
  #   不配schema + field_mapping = 旧自定义路径（完全向后兼容）
  # siem_kafka_ecs:
  #   type: kafka
  #   poll_interval: 1
  #   config:
  #     bootstrap_servers: 10.0.0.1:9092
  #     topic: siem-alerts
  #     group_id: aicso-consumer
  #     schema: ecs                  # ECS源零映射
  #     # 弱实体提取（issue #44）：ECS源默认按profile提取 host/user/file_hash/dst_domain
  #     # 非标准字段名可用 entity_mapping 覆盖：{"host": "computer_name"}
  #     # entity_short_name: true     # host FQDN→短名（归一责任默认数据源侧，引擎侧可选）
  # siem_kafka:
  #   ...以下为自定义映射示例...
  #   type: kafka
  #   enabled: true
  #   description: "态势感知平台Kafka告警源"
  #   config:
  #     bootstrap_servers: 10.0.0.1:9092,10.0.0.2:9092,10.0.0.3:9092
  #     topic: siem-alerts
  #     group_id: aicso-consumer
  #     auto_offset_reset: latest
  #     max_batch_size: 100
  #     poll_timeout_ms: 5000
  #     message_format: json
  #     field_mapping:
  #       alert_id: alert_id
  #       rule_name: rule_name
  #       severity: severity
  #       src_ip: src_ip
  #       dst_ip: dst_ip
  #       timestamp: timestamp
  #     severity_mapping:
  #       1: critical
  #       2: high
  #       3: medium
  #       4: low
  #       5: info

  # ⚠ 消费组规范：group_id 必须独立于其他服务——同组消费会互抢分区
  # 导致双方都丢消息；不同 group_id 各自独立拿全量流互不影响。
  # 命名建议：aicso-<环境>-<数据源名>（如 aicso-prod-siem-alerts），
  # 个人开发实例务必独立命名（如 aicso-dev-<姓名>-siem）防抢生产分区；
  # 同服务多副本扩容时用相同 group_id（分摊分区）；组名定后勿改
  # （改名=新组=offset按auto_offset_reset重算，earliest会整topic重放）。
  # 位点语义（at-least-once）：批次告警全部持久化成功后才提交offset；
  # 崩溃/系统级失败不提交→重启重投，重复投递由 alert_id 主键幂等吸收。
  # since 参数对 Kafka 无效（起点由 group_id + auto_offset_reset 决定）。

  # 示例：REST API（SIEM HTTP接口）
  # siem_api:
  #   type: rest_api
  #   enabled: true
  #   config:
  #     base_url: https://siem.example.com/api/v1
  #     auth_type: bearer
  #     api_token: ${SIEM_API_TOKEN}
  #     alerts_endpoint: /alerts

  # 示例：Syslog文件监听
  # syslog_file:
  #   type: syslog
  #   enabled: true
  #   config:
  #     log_path: /var/log/siem/alerts.log
